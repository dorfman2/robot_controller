[Unit]
Description=Armold Motion Controller Daemon
Documentation=https://github.com/dorfman2/Armold
After=network.target klipper.service moonraker.service
Wants=network.target
Requires=moonraker.service

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/home/pi/Armold
# Runs in the armold venv (virtualenv --system-site-packages) so the IK stack
# (roboticstoolbox / scipy / spatialmath) is available on top of the apt-managed
# numpy/pyserial/websockets/aiohttp. See scripts/deploy_controller.sh.
ExecStart=/home/pi/armold-venv/bin/python -m armold_controller
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

# Hardening (Klipper mode: no direct serial access needed)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
